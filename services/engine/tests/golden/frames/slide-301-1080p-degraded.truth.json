  "blocks": [
    {
      "kind": "heading",
      "level": 1,
      "text": "Lecture 7: Virtual memory"
    },
    {
      "kind": "paragraph",
      "level": null,
      "text": "This document describes how the service handles retries when a downstream dependency fails."
    },
    {
      "kind": "heading",
      "level": 2,
      "text": "Key points"
    },
    {
      "kind": "list_item",
      "level": null,
      "text": "Each process sees its own address space"
    },
    {
      "kind": "list_item",
      "level": null,
      "text": "Pages are 4 KiB on most x86 systems"
    },
    {
      "kind": "list_item",
      "level": null,
      "text": "The TLB caches recent translations"
    },
    {
      "kind": "list_item",
      "level": null,
      "text": "A page fault traps into the kernel"
    },
    {
      "kind": "heading",
      "level": 2,
      "text": "Details"
    },
    {
      "kind": "paragraph",
      "level": null,
      "text": "Owners review the dashboard every Monday and file tickets for regressions."
    },
    {
      "kind": "paragraph",
      "level": null,
      "text": "Idempotency keys make retries safe for payment and invite endpoints."
    },
    {
      "kind": "paragraph",
      "level": null,
      "text": "Alerts fire when the retry rate exceeds 5% over a ten-minute window."
    }
  ],
