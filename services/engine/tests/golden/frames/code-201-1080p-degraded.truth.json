  "code": {
    "file_name": "grades.py",
    "language": "python",
    "lines": [
      {
        "n": 1,
        "text": "from statistics import mean"
      },
      {
        "n": 2,
        "text": ""
      },
      {
        "n": 3,
        "text": "PASS_MARK = 51"
      },
      {
        "n": 4,
        "text": "WEIGHTS = {\"quiz\": 0.2, \"midterm\": 0.3, \"final\": 0.5}"
      },
      {
        "n": 5,
        "text": ""
      },
      {
        "n": 6,
        "text": ""
      },
      {
        "n": 7,
        "text": "def weighted_score(tally: dict[str, float]) -> float:"
      },
      {
        "n": 8,
        "text": "    total = 0.0"
      },
      {
        "n": 9,
        "text": "    for part, weight in WEIGHTS.items():"
      },
      {
        "n": 10,
        "text": "        total += tally.get(part, 0.0) * weight"
      },
      {
        "n": 11,
        "text": "    return round(total, 2)"
      },
      {
        "n": 12,
        "text": ""
      },
      {
        "n": 13,
        "text": ""
      },
      {
        "n": 14,
        "text": "def term(roster: list[dict[str, float]]) -> dict[str, int]:"
      },
      {
        "n": 15,
        "text": "    scores = [weighted_score(s) for s in roster]"
      },
      {
        "n": 16,
        "text": "    passed = sum(1 for s in scores if s >= PASS_MARK)"
      },
      {
        "n": 17,
        "text": "    return {"
      },
      {
        "n": 18,
        "text": "        \"count\": len(scores),"
      },
      {
        "n": 19,
        "text": "        \"passed\": passed,"
      },
      {
        "n": 20,
        "text": "        \"failed\": len(scores) - passed,"
      },
      {
        "n": 21,
        "text": "        \"average\": int(mean(scores)) if scores else 0,"
      },
      {
        "n": 22,
        "text": "    }"
      },
      {
        "n": 23,
        "text": ""
      },
      {
        "n": 24,
        "text": ""
      },
      {
        "n": 25,
        "text": "if __name__ == \"__main__\":"
      },
      {
        "n": 26,
        "text": "    print(term([{\"quiz\": 80, \"midterm\": 72, \"final\": 65}]))"
      }
    ],
    "cursor_line": 12
  },
