        "text": "const app = express();"
      },
      {
        "n": 4,
        "text": "const PORT = Number(process.env.PORT ?? 3100);"
      },
      {
        "n": 5,
        "text": "const allowRequest = new Map<string, number>();"
      },
      {
        "n": 6,
        "text": ""
      },
      {
        "n": 7,
        "text": "app.use(express.json({ limit: '4kb' }));"
      },
      {
        "n": 8,
        "text": ""
      },
      {
        "n": 9,
        "text": "app.get('/health', (_req, res) => {"
      },
