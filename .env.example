# services/engine/.env
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
# live | record | replay (CI uses replay; never calls the API)
UNSCREEN_LLM_MODE=live
UNSCREEN_ALLOWED_ORIGINS=["http://localhost:5173"]
# Shared across sessions, providers, retries and local benchmark processes. UTC reset.
UNSCREEN_DAILY_MODEL_CALLS=500
UNSCREEN_DAILY_MODEL_USD=2.00
# Conservative reservation for each attempt; failed attempts retain it.
UNSCREEN_MODEL_CALL_RESERVE_USD=0.10
# Keep this ledger persistent; one instance/volume for a shared daily cap.
# UNSCREEN_BUDGET_PATH=/absolute/persistent/path/model-budget.sqlite3

# apps/web/.env
VITE_ENGINE_URL=http://localhost:8787
