  "description": "Root that pulls every wire type into one schema.",
  "properties": {
    "client_message": {
      "discriminator": {
        "mapping": {
          "ask": "#/$defs/Ask",
          "frame": "#/$defs/Frame",
          "hello": "#/$defs/Hello",
          "pointer": "#/$defs/PointerMsg",
          "settings": "#/$defs/Settings"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Hello"
        },
        {
          "$ref": "#/$defs/Frame"
        },
        {
          "$ref": "#/$defs/PointerMsg"
        },
        {
          "$ref": "#/$defs/Ask"
        },
        {
          "$ref": "#/$defs/Settings"
        }
      ]
    },
    "document": {
      "$ref": "#/$defs/Document"
    },
    "server_message": {
      "discriminator": {
        "mapping": {
          "announce": "#/$defs/Announce",
          "answer": "#/$defs/Answer",
          "error": "#/$defs/Error",
          "patch": "#/$defs/Patch",
          "pointer_target": "#/$defs/PointerTarget",
          "snapshot": "#/$defs/Snapshot",
          "status": "#/$defs/Status"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Snapshot"
        },
        {
          "$ref": "#/$defs/Patch"
        },
        {
          "$ref": "#/$defs/Announce"
        },
        {
          "$ref": "#/$defs/PointerTarget"
        },
        {
          "$ref": "#/$defs/Answer"
        },
        {
          "$ref": "#/$defs/Status"
        },
        {
          "$ref": "#/$defs/Error"
        }
      ]
    },
    "session_grant": {
      "$ref": "#/$defs/SessionGrant"
    }
  },
  "required": [
    "document",
    "client_message",
    "server_message",
    "session_grant"
  ],
  "title": "UnScreenSchema",
  "type": "object"
}
